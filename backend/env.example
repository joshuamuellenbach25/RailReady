# Copy to backend/.env. core.py loads that file at startup.

# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=railready
JWT_SECRET=change-me-to-a-long-random-string
# Password for every seeded demo account. The seed and the tests read it.
SEED_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# AI features (photo findings, voice extraction) and cloud file storage.
# Leave empty to run standalone: files are kept on local disk instead.
EMERGENT_LLM_KEY=
# RAILREADY_STORAGE_DIR=./.local_storage
# INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
# IMAGE_MODEL_ID=claude-sonnet-5-5

# Invoice email channel (optional; sending stays off until both are set)
# EMERGENT_EMAIL_KEY=
# EMAIL_FROM_NAME=RailReady

# 3D scene per photo: path to the Depth Anything V2 Small ONNX file
RAILREADY_DEPTH_MODEL_PATH=

# Optional local models
# WHISPER_MODEL=small
# LLM_GGUF_PATH=/path/to/qwen2.5-3b-instruct-q4_k_m.gguf
# LLM_CALL_TIMEOUT_S=170

# Test-only: lets the tests trigger simulated provider failures
# ALLOW_FAULT_INJECTION=false
